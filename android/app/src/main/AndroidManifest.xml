<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Галерея и вставка ключа доступны и на устройствах без камеры. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!--
        Android TV: тот же туннель на телевизоре, где Netflix и YouTube.
        Сенсорного экрана там нет — управление пультом, и всё приложение
        проходится стрелками. Не обязательны: на телефоне ничего не меняется.
    -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Видеть, есть ли сеть кроме туннеля: без неё уведомление писало «Подключено» без сети. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Просьба «не усыплять в фоне» на втором шаге первого запуска: без неё система убивает туннель через час. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Чтобы поднять туннель после перезагрузки телефона. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        С Android 11 приложение не видит чужих пакетов, пока не скажет, какие
        ему нужны. Без этого в списке «мимо туннеля» из трёх сотен приложений
        оставались три системных, и человек не находил свой банк. Просим
        ровно то, что показываем: приложения с экраном запуска. Не
        QUERY_ALL_PACKAGES: за него Play требует объяснений, а нам всё
        остальное и не нужно.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
        allowBackup выключен намеренно. В настройках лежит ключ доступа, а в
        нём личный ключ покупателя. Включённое резервное копирование отправило
        бы его в облако производителя телефона, то есть вынесло бы наружу
        ровно то, ради чего всё и затевалось.
    -->
    <application
        android:name=".MarviaApp"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Veil">

        <activity android:name=".QrCameraActivity" android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!--
                Ссылку из телеграма покупатель просто нажимает. Без этого он
                держит её в буфере обмена, ищет приложение и вставляет вручную —
                и именно здесь теряется тот, ради кого всё делается.

                Своя схема, а не https: у покупателя не должно быть шага, на
                котором ссылка уходит в браузер, а с ней и адрес панели
                продавца — в историю, синхронизацию и подсказки поиска.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="marvia" />
                <!-- Старая схема: ключи, выданные до переименования, живут в переписке покупателей и должны открываться по-прежнему. -->
                <data android:scheme="veil-account" />
            </intent-filter>

            <!--
                Чужие ссылки нод: нажатая в чате vless:// и прочие открывают
                Marvia наравне с Happ и Hiddify — система предложит выбрать.
                Замена стоящего ключа всё равно спрашивается (acceptLinkFrom).
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vless" />
                <data android:scheme="vmess" />
                <data android:scheme="trojan" />
                <data android:scheme="ss" />
                <data android:scheme="hysteria2" />
                <data android:scheme="hy2" />
                <data android:scheme="wireguard" />
                <data android:scheme="wg" />
            </intent-filter>
        </activity>

        <!--
            Язык приложения на Android старше 13 хранит сам AppCompat — в этой
            службе-заглушке лежит только разрешение ему это делать. На 13 и
            новее выбор уходит в системную настройку «язык приложения».
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!--
            Кнопка в шторке. TOGGLEABLE_TILE говорит системе, что это
            переключатель: она нарисует его включённым и выключенным, а
            TalkBack прочтёт состояние.
        -->
        <service
            android:name=".TunnelTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_marvia"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!--
            specialUse — единственный подходящий вид постоянной службы: своего
            вида для VPN в Android не завели, а без постоянной службы система
            выгрузит нас из памяти вместе с туннелем.
        -->
        <service
            android:name=".MarviaVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
